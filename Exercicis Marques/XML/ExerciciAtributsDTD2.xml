<!DOCTYPE Empresa [
    <!ELEMENT Empresa (Empleat+)>
    <!ELEMENT Empleat (Cognom, Nom, CorreuElectronic, Telefon, Adreça)
    <!ATTLIST Empleat
                NumEmpleat CDATA #REQUIRED>
    <!ELEMENT Cognom #PCDATA>
    <!ELEMENT Nom #PCDATA>
    <!ELEMENT CorreuElectronic #PCDATA>
    <!ELEMENT Telefon #PCDATA>
    <!ELEMENT Adreça EMPTY>
